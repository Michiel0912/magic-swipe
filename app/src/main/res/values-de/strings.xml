<string name="app_name">Magic Swipe</string><string name="service_name">Magic Swipe</string>
<string name="accessibility_description">Erweitert den nutzbaren Startbereich der systemeigenen Zurück-Geste mit transparenten Randzonen. Der Dienst liest keine Bildschirminhalte und verwendet kein Netzwerk.</string>
<string name="intro">Fügt direkt innerhalb des vorhandenen Zurück-Randes eine schmale transparente Zone hinzu. Die native Zurück-Zone des Telefons bleibt unverändert.</string>
<string name="service_active">Dienst: AKTIV</string><string name="service_inactive">Dienst: NICHT AKTIV</string>
<string name="native_zone_format">Erkannte native Zone: %1$d px (%2$.1f dp). Die zusätzliche Zone beginnt direkt innerhalb davon.</string>
